# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5008

# Workspace Docker Mongo. Postgres on this machine is 5433; Mongo is standard 27017.
DATABASE_URL=mongodb://localhost:27017/tafutakeja

# Sign the session cookie. Any long random string; changing it logs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS allowlist. The dev frontend is pinned to 5013 in vite.config.js — if you
# change one, change the other or every request fails as a CORS error that looks
# like an application bug.
FRONTEND_URL=http://localhost:5013
PROD_FRONTEND_URL=https://tafutakeja.netlify.app

# Raise only for local test runs — the suite signs in as four accounts and
# deliberately fails two logins, and re-running it inside one 15-minute window
# otherwise trips the limiter. Leave unset in production.
# AUTH_RATE_LIMIT_MAX=200

# The whole-API ceiling, per IP per 15 minutes. Raise it when driving the app
# from a browser harness: every page load costs several calls, so a role-by-role
# walkthrough exhausts 600 long before a person would, and once it trips every
# endpoint 429s — `/health` included, which reads as a dead server.
# RATE_LIMIT_MAX=5000
